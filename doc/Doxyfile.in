# Doxygen configuration for the {fmt} API reference.
# This file is processed by CMake (see FMT_DOXYGEN in CMakeLists.txt).
#
# Variables other than @PROJECT_SOURCE_DIR@ always make up a whole value, so the
# file still documents the headers if a tool substitutes only the standard
# variables and blanks the rest.

PROJECT_NAME           = "{fmt}"
PROJECT_NUMBER         = @FMT_VERSION@
PROJECT_BRIEF          = "A modern formatting library"
OUTPUT_DIRECTORY       = @FMT_DOXYGEN_OUTPUT_DIR@
STRIP_FROM_PATH        = @PROJECT_SOURCE_DIR@/include \
                         @FMT_DOXYGEN_PAGES_DIR@
STRIP_FROM_INC_PATH    = @PROJECT_SOURCE_DIR@/include
FULL_PATH_NAMES        = YES
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_LOGFILE           = @FMT_DOXYGEN_WARN_LOGFILE@

# Input: the Markdown pages converted from doc/ plus the public headers.
# Keep the header list in sync with add_doxygen_doc_target in CMakeLists.txt.
INPUT                  = @FMT_DOXYGEN_PAGES_INPUT@ \
                         @PROJECT_SOURCE_DIR@/include/fmt/args.h \
                         @PROJECT_SOURCE_DIR@/include/fmt/chrono.h \
                         @PROJECT_SOURCE_DIR@/include/fmt/color.h \
                         @PROJECT_SOURCE_DIR@/include/fmt/compile.h \
                         @PROJECT_SOURCE_DIR@/include/fmt/core.h \
                         @PROJECT_SOURCE_DIR@/include/fmt/enum.h \
                         @PROJECT_SOURCE_DIR@/include/fmt/format.h \
                         @PROJECT_SOURCE_DIR@/include/fmt/os.h \
                         @PROJECT_SOURCE_DIR@/include/fmt/ostream.h \
                         @PROJECT_SOURCE_DIR@/include/fmt/printf.h \
                         @PROJECT_SOURCE_DIR@/include/fmt/ranges.h \
                         @PROJECT_SOURCE_DIR@/include/fmt/std.h \
                         @PROJECT_SOURCE_DIR@/include/fmt/xchar.h
FILE_PATTERNS          = *.h *.md *.dox
RECURSIVE              = NO
USE_MDFILE_AS_MAINPAGE = @FMT_DOXYGEN_MAINPAGE@
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3
AUTOLINK_SUPPORT       = YES
IMAGE_PATH             = @PROJECT_SOURCE_DIR@/doc

# Only document the public API.
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
EXCLUDE_SYMBOLS        = detail::* fmt::detail::* *_impl
INLINE_INHERITED_MEMB  = YES
SORT_MEMBER_DOCS       = NO
JAVADOC_AUTOBRIEF      = YES

# The headers rely heavily on macros; expand the ones that affect declarations.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = @PROJECT_SOURCE_DIR@/include
PREDEFINED             = _WIN32=1 \
                         __linux__=1 \
                         FMT_ENABLE_IF(...)= \
                         FMT_USE_USER_LITERALS=1 \
                         FMT_USE_ALIAS_TEMPLATES=1 \
                         FMT_USE_NONTYPE_TEMPLATE_ARGS=1 \
                         FMT_API= \
                         "FMT_BEGIN_NAMESPACE=namespace fmt {" \
                         "FMT_END_NAMESPACE=}" \
                         FMT_DOC=1

# Output formats.
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_EXTRA_STYLESHEET  =
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO
SOURCE_BROWSER         = NO
HAVE_DOT               = NO
